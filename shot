#!/usr/bin/env node
// edge-shot CLI — ezt hívja a Claude skill. Gondoskodik róla, hogy a szerver fusson.
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { spawn, spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';

// A gyökér a SZKRIPT helye, ne a HOME: máshova klónozva is működnie kell.
const ROOT = path.dirname(fileURLToPath(import.meta.url));
const LOG = path.join(ROOT, 'server.log');

if (!fs.existsSync(path.join(ROOT, 'config.json'))) {
  console.error(`Nincs config.json — futtasd előbb: ${path.join(ROOT, 'install.sh')}`);
  process.exit(2);
}
const CFG = JSON.parse(fs.readFileSync(path.join(ROOT, 'config.json'), 'utf8'));
const BASE = `http://127.0.0.1:${CFG.port || 8765}`;
const HDR = { 'x-shot-token': CFG.token };
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function health() {
  try {
    const r = await fetch(`${BASE}/health`, { signal: AbortSignal.timeout(1500) });
    return r.ok ? await r.json() : null;
  } catch { return null; }
}

async function ensureServer() {
  let h = await health();
  if (h) return h;
  const out = fs.openSync(LOG, 'a');
  spawn(process.execPath, [path.join(ROOT, 'server.mjs')],
        { detached: true, stdio: ['ignore', out, out] }).unref();
  for (let i = 0; i < 40; i++) {
    await sleep(150);
    h = await health();
    if (h) return h;
  }
  throw new Error(`a szerver nem indult el — nézd meg: ${LOG}`);
}

// MÉRVE: a `--tab 12a` NaN-t adott, ami JSON-ban null lett, és a bővítmény némán az
// AKTÍV fület fotózta. Egy bizonyíték-eszközben a néma célt-tévesztés a legrosszabb.
function num(v, name, { min, max, integer } = {}) {
  if (v === undefined) return undefined;
  // Érték nélküli `--tab` (pl. `--tab --mode fullpage`) korábban némán undefined lett,
  // és a bővítmény az AKTÍV fület fotózta: ugyanaz a néma célt-tévesztés, mint a NaN-nál.
  if (v === true) { console.error(`a --${name} kapcsolóhoz érték kell`); process.exit(1); }
  const n = Number(v);
  if (!Number.isFinite(n) || (integer && !Number.isInteger(n))) {
    console.error(`a --${name} értéke nem ${integer ? 'egész ' : ''}szám: ${v}`); process.exit(1);
  }
  if (min !== undefined && n < min) { console.error(`a --${name} nem lehet ${min}-nél kisebb (kaptam: ${n})`); process.exit(1); }
  if (max !== undefined && n > max) { console.error(`a --${name} nem lehet ${max}-nél nagyobb (kaptam: ${n})`); process.exit(1); }
  return n;
}

// Az ismételhető kapcsolók FEHÉRLISTÁN vannak, nem általánosan gyűjtünk: az általános
// gyűjtés egy véletlenül kétszer megadott --match-et tömbbé tenne, amit a többi parancs
// sztringként használ, és a hiba némán rossz fülre fotózna.
const REPEATABLE = new Set(['clip']);
// Az érték nélküli kapcsolók SOSEM nyelik el a következő szót: különben a
// `shot rec --gif klip --seconds 5` alakban a „klip" a --gif értéke lett, és név nem maradt.
const BOOLEAN = new Set(['url', 'gif', 'force', 'verify', 'no-verify', 'help']);

function parseArgs(argv) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const k = a.slice(2);
      const next = argv[i + 1];
      const val = (BOOLEAN.has(k) || next === undefined || next.startsWith('--')) ? true : (i++, next);
      if (REPEATABLE.has(k)) (out[k] ||= []).push(val);
      else out[k] = val;
    } else out._.push(a);
  }
  return out;
}

const USAGE = `
edge-shot — veszteségmentes képernyőkép a bejelentkezett böngésződből, fájlba

  shot health                       a szerver és az extension állapota
  shot tabs                         a nyitott fülek (id, cím, URL)
  shot probe --selector "<css>"     mit talál a selector, és mekkora (elem-mód előtt)
  shot check                        fordul-e a bővítmény forrása (reload előtt automatikus)
  shot reload                       a bővítmény újratöltése kódváltozás után
  shot <név> [kapcsolók]            kép készítése

Kapcsolók:
  --mode viewport|fullpage|element  alapértelmezés: viewport
  --selector "<css>"                element módhoz kötelező
  --padding <px>                    element módhoz, alapértelmezés 0
  --tab <id>                        cél fül azonosítója
  --match "<szöveg>"                cél fül URL/cím részlet alapján
  --mobile [szélesség]              mobil viewport-emuláció (alap: 390)
  --scale <n>                       device pixel ratio, alapértelmezés 2
  --settle <ms>                     várakozás a fotó előtt
  --url                             fehér sáv a kép tetején, benne feketén az URL
                                    (bug-jegyhez, ahol a konvenció a látszó címsáv)

Videó (eseménysorhoz, nem állóképhez):
