{
  "manifest_version": 3,
  "name": "edge-shot",
  "version": "1.0.0",
  "description": "Lossless screenshots and recordings for the edge-shot CLI. Works in any Chromium browser (Edge, Chrome, Chromium, Brave).",
  "permissions": [
    "tabs",
    "debugger",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "edge-shot — click to reconnect"
  }
}
